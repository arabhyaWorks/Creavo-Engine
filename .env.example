# Gemini API (REST) — get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_key_here

# Gemini model used for image generation
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Gemini text model used for design thinking + QA
GEMINI_VISION_MODEL=gemini-2.5-flash

# OpenAI API — get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_key_here

# OpenAI model used for design thinking (vision-capable)
OPENAI_DESIGN_MODEL=gpt-4o

# Object storage (S3-compatible)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=

# Meta / Instagram
META_APP_ID=
META_APP_SECRET=
